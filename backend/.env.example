# Copy to .env (local) or add these in Render → Environment
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/modshine?retryWrites=true&w=majority
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin studio login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password
# 64+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
