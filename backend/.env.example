# Copy to .env (local) or add these in Render → Environment
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/modshine?retryWrites=true&w=majority
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin studio login
# Admin users are stored in the database. On first start a default admin is created:
#   username: admin   password: admin@123   (change it in Admin → Account & Password)
# Optional: set these to choose different FIRST-RUN credentials instead.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-long-password
# Optional extra secret mixed into session signatures
# AUTH_SECRET=
